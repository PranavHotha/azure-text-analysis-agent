# Azure AI Foundry Configuration
# Copy this file to .env and fill in your values
# Authenticate using Azure CLI: az login

FOUNDRY_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project-id>"
AGENT_NAME="your_agent_name"
MODEL_DEPLOYMENT_NAME="model_name"

# Microsoft Entra ID (Azure AD) Multi-Tenant Authentication (Optional)
# If provided, enables "Sign in with Microsoft" so any user can use their own Azure account
ENTRA_CLIENT_ID=""
ENTRA_TENANT_ID="common"
ENTRA_CLIENT_SECRET=""
ENTRA_REDIRECT_URI="http://localhost:8501"
